# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# SEC fair-access policy: every request must send a User-Agent with your name and contact email.
SEC_USER_AGENT="FilingLens Your Name your.email@example.com"
# Google Cloud project (BigQuery sandbox) and HCP Terraform organization
GCP_PROJECT_ID=your-gcp-project-id
TF_VAR_project_id=your-gcp-project-id
TF_CLOUD_ORGANIZATION=your-hcp-organization

# Local Postgres for sql/ (compose.yaml); any random string, e.g. openssl rand -hex 16
POSTGRES_PASSWORD=
