# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# SEC fair-access policy: every request must send a User-Agent with your name and contact email.
SEC_USER_AGENT="FilingLens Your Name your.email@example.com"
# Google Cloud project (BigQuery sandbox) and HCP Terraform organization
GCP_PROJECT_ID=your-gcp-project-id
TF_VAR_project_id=your-gcp-project-id
TF_CLOUD_ORGANIZATION=your-hcp-organization

# Local Postgres for sql/ (compose.yaml); any random string, e.g. openssl rand -hex 16
POSTGRES_PASSWORD=

# Local Label Studio (compose.yaml, FL-M2): admin login and API token, created on first start.
# The username must look like an email address; generate the two secrets with openssl.
LABEL_STUDIO_USERNAME=labeler@filinglens.local
LABEL_STUDIO_PASSWORD=
LABEL_STUDIO_USER_TOKEN=
MLFLOW_TRACKING_URI=http://127.0.0.1:55000
# Local Qdrant (compose.yaml, FL-M3); no API key: the port is bound to localhost only
QDRANT_URL=http://127.0.0.1:56333
